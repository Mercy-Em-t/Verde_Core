generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id
  name      String
  pm        String
  status    String
  sponsor   String?
  need      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
